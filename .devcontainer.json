{
  "name": "plasticrake/fp_smart_connect",
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  // Installed directly with apt-get rather than via the
  // ghcr.io/devcontainers-extra/features/apt-packages feature: that
  // feature's installer binary (nanolayer, statically linked against
  // jemalloc) aborts with "Unsupported system page size" on hosts with a
  // 16KB page size (e.g. this repo's Raspberry Pi dev host), since it
  // assumes 4KB pages.
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends ffmpeg libturbojpeg0 libpcap-dev",
  "postCreateCommand": ".devcontainer/setup.sh && scripts/setup",
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "mounts": [
    "source=claude-code-config,target=/home/vscode/.claude,type=volume",
    "source=gh-config,target=/home/vscode/.config/gh,type=volume",
    "source=/run/dbus,target=/run/dbus,type=bind"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "UV_LINK_MODE": "copy",
    "UV_COMPILE_BYTECODE": "1"
  },
  "forwardPorts": [8123],
  "portsAttributes": {
    "8123": {
      "label": "Home Assistant",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astral-sh.ty",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "github.vscode-pull-request-github",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ryanluker.vscode-coverage-gutters",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 4,
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.formatOnType": false,
        "files.trimTrailingWhitespace": true,
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.autoImportCompletions": true,
        "python.analysis.diagnosticSeverityOverrides": {
          "reportPrivateImportUsage": "none"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[shellscript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[toml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[yaml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    },
    "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {
      "version": "latest",
      "shellautocompletion": true
    },
    "ghcr.io/devcontainer-community/devcontainer-features/ripgrep:1": {},
    // "ghcr.io/devcontainers-extra/features/apt-packages:1": {
    // 	"packages": "ffmpeg,libturbojpeg0,libpcap-dev"
    // },
    "ghcr.io/devcontainers/features/node:2": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  }
}
