{
  "entity": {
    "media_player": {
      "sound": {
        "default": "mdi:music-box-outline",
        "state": {
          "playing": "mdi:music-box"
        }
      }
    },
    "light": {
      "nightlight": {
        "default": "mdi:lightbulb-night",
        "state": {
          "off": "mdi:lightbulb-night-outline"
        }
      },
      "star_projection": {
        "default": "mdi:star-shooting",
        "state": {
          "off": "mdi:star-shooting-outline"
        },
        "state_attributes": {
          "effect": {
            "default": "mdi:star-shooting",
            "state": {
              "rainbow": "mdi:looks",
              "cool_colors": "mdi:snowflake",
              "warm_colors": "mdi:fire",
              "custom": "mdi:palette"
            }
          }
        }
      },
      "animal_projection": {
        "default": "mdi:paw",
        "state": {
          "off": "mdi:paw-outline"
        },
        "state_attributes": {
          "effect": {
            "default": "mdi:elephant",
            "state": {
              "lighthouse": "mdi:lighthouse",
              "candle": "mdi:candle"
            }
          }
        }
      }
    },
    "select": {
      "star_projection_speed": {
        "default": "mdi:speedometer",
        "state": {
          "slow": "mdi:speedometer-slow",
          "normal": "mdi:speedometer-medium"
        }
      },
      "animal_projection_speed": {
        "default": "mdi:speedometer",
        "state": {
          "slow": "mdi:speedometer-slow"
        }
      },
      "music_timer": {
        "default": "mdi:timer-music-outline",
        "state": {
          "continuous": "mdi:infinity"
        }
      },
      "light_timer": {
        "default": "mdi:timer-outline",
        "state": {
          "continuous": "mdi:infinity"
        }
      },
      "sleep_stages": {
        "default": "mdi:sleep",
        "state": {
          "off": "mdi:sleep-off",
          "settle": "mdi:weather-sunset-down",
          "soothe": "mdi:weather-night"
        }
      },
      "settle_timer": {
        "default": "mdi:timer-outline"
      },
      "soothe_timer": {
        "default": "mdi:timer-outline"
      },
      "sleep_timer": {
        "default": "mdi:bed-clock",
        "state": {
          "continuous": "mdi:infinity"
        }
      },
      "star_color": {
        "default": "mdi:palette",
        "state": {
          "off": "mdi:palette-outline"
        }
      }
    },
    "sensor": {
      "settling_playlist": {
        "default": "mdi:playlist-music"
      },
      "soothing_playlist": {
        "default": "mdi:playlist-music"
      },
      "firmware_version": {
        "default": "mdi:chip"
      },
      "firmware_api_level": {
        "default": "mdi:numeric"
      },
      "device_error": {
        "default": "mdi:alert-circle-outline"
      }
    },
    "binary_sensor": {
      "sound_expiring": {
        "default": "mdi:timer-sand",
        "state": {
          "off": "mdi:timer-sand-complete"
        }
      },
      "light_expiring": {
        "default": "mdi:timer-sand",
        "state": {
          "off": "mdi:timer-sand-complete"
        }
      }
    }
  },
  "services": {
    "set_playlist": {
      "service": "mdi:playlist-edit"
    },
    "apply_preset": {
      "service": "mdi:playlist-music"
    }
  }
}
